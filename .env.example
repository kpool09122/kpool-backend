# Local development configuration. Copy to .env.
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://127.0.0.1:8080
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kpool
DB_USERNAME=kpool
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379
# Disable only for local HTTP development; production defaults to true.
SESSION_SECURE_COOKIE=false

MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@kpool.local

LOG_CHANNEL=daily
LOG_LEVEL=debug

# Gemini (inject GENERATIVE_LANGUAGE_API_KEY separately).
GEMINI_MODEL=gemini-3.8-flash

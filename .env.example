# Local development configuration. Copy to .env.
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://127.0.0.1:8080
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kpool
DB_USERNAME=kpool
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PORT=6379

# API rate limits per fixed window (seconds).
API_RATE_LIMIT_DECAY_SECONDS=60
API_RATE_LIMIT_GLOBAL_QUERY=3000
API_RATE_LIMIT_GLOBAL_COMMAND=600
API_RATE_LIMIT_SCREEN_ACCOUNT_QUERY=600
API_RATE_LIMIT_SCREEN_ACCOUNT_COMMAND=120
API_RATE_LIMIT_SCREEN_IP_QUERY=300
API_RATE_LIMIT_SCREEN_IP_COMMAND=30
API_RATE_LIMIT_PUBLIC_ACCOUNT_QUERY=600
API_RATE_LIMIT_PUBLIC_ACCOUNT_COMMAND=120
API_RATE_LIMIT_PUBLIC_IP_QUERY=300
API_RATE_LIMIT_PUBLIC_IP_COMMAND=30

# Disable only for local HTTP development; production defaults to true.
SESSION_SECURE_COOKIE=false

MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@kpool.local

LOG_CHANNEL=daily
LOG_LEVEL=debug

# Local defaults; production values are described in docs/s3-storage.md.
IMAGE_STORAGE_DISK=public
VERIFICATION_DOCUMENTS_DRIVER=local
AWS_DEFAULT_REGION=ap-northeast-1
# Production: s3 + s3; inject the separate CloudFormation bucket Outputs.
# AWS_PUBLIC_IMAGES_BUCKET=
# AWS_PRIVATE_FILES_BUCKET=
# IMAGE_BASE_URL=https://images.example.com
# ECS uses task-role credentials; do not set static AWS keys in production.

# Gemini (inject GENERATIVE_LANGUAGE_API_KEY separately).
GEMINI_MODEL=gemini-3.8-flash

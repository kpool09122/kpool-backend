# Production configuration: only values safe to commit belong in this file.
# Set the deployment-specific values below before deploying.
# Copy this file to .env for Laravel to load it with APP_ENV=production.
# Inject secrets from Secret Manager as runtime environment variables before
# building Laravel's configuration cache; do not add secret values here.

# Application
APP_ENV=production
APP_DEBUG=false
# APP_URL=https://<backend-domain>
# FRONTEND_URL=https://<frontend-domain>

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=info

# PostgreSQL
DB_CONNECTION=pgsql
DB_PORT=5432
# DB_HOST=<database-host>
# DB_DATABASE=<database-name>
# DB_USERNAME=<database-user>

# Redis (sessions and cache)
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_HOST=<redis-host>
SESSION_SECURE_COOKIE=true

# SQS: inject integration stack's QueueUrl via runtime configuration.
# All three logical queues share #673's kpool-prod-work-v1 work queue.
QUEUE_CONNECTION=sqs
AWS_DEFAULT_REGION=ap-northeast-1
# SQS_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/<account-id>/kpool-prod-work-v1
# No AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: use the ECS task role.
QUEUE_FAILED_DRIVER=database-uuids

# Mail
MAIL_MAILER=smtp
# MAIL_HOST=<smtp-host>
# MAIL_PORT=<smtp-port>
# MAIL_ENCRYPTION=<smtp-encryption>
# MAIL_FROM_ADDRESS=<sender-address>

# OAuth and passkeys
GOOGLE_CLIENT_ID=323712597774-e7h3sbpenh18rs0d7l3qh375r49u3fr3.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=https://<backend-domain>/api/identity/auth/social/google/callback
LINE_CLIENT_ID=2008812862
LINE_REDIRECT_URI=https://<backend-domain>/api/identity/auth/social/line/callback
KAKAO_CLIENT_ID=591e0cbd7c1369056b7f7e1b419631b5
KAKAO_REDIRECT_URI=https://<backend-domain>/api/identity/auth/social/kakao/callback
# WEBAUTHN_RP_ID=<frontend-domain>
# WEBAUTHN_ALLOWED_ORIGINS=https://<frontend-domain>

# Google APIs: use runtime Application Default Credentials.
GEMINI_MODEL=gemini-3.8-flash
# GOOGLE_PROJECT_ID=<google-project-id>

# Sentry
SENTRY_LARAVEL_DSN=https://f914ad6d89ccf3be54bfeead39756e0a@o4511212395495424.ingest.us.sentry.io/4511212401983488

# Secret Manager variables (omit unused integrations):
# APP_KEY, APP_PREVIOUS_KEYS, DB_PASSWORD, REDIS_USERNAME, REDIS_PASSWORD,
# MAIL_USERNAME, MAIL_PASSWORD, GOOGLE_CLIENT_SECRET, LINE_CLIENT_SECRET,
# KAKAO_CLIENT_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# YOUTUBE_API_KEY, GENERATIVE_LANGUAGE_API_KEY.
# Credential-bearing DATABASE_URL, REDIS_URL and MAIL_URL also belong there.
